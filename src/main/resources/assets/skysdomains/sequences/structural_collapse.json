{
  "_comment": "Structural Collapse. Phases and their lengths come from the server (config): activation 30, expand 20, solar_system 50, collapse 30, bombardment (planets * interval + flight + 10 [+ sun]), end 30. Ticks are relative to the phase start. Planet launches/impacts are server events (see 'events').",
  "sphere": {"texture": "skysdomains:scene/sphere_structural_collapse", "color": "#FFFFFF", "alpha": 0.5, "inside_alpha": 1.0, "inside_opaque": true, "scroll": 0.001, "emissive": true},
  "phases": {
    "activation": [
      {"tick": 0, "actions": [
        {"type": "audio_duck", "duration": 260, "level": 0.1},
        {"type": "sound", "id": "skysdomains:structural_collapse.open", "volume": 1.6, "pitch": 0.8, "at": "player"},
        {"type": "sphere_scale", "from": 0.0, "to": 0.05, "duration": 30, "easing": "ease_out_quad"},
        {"type": "fov_punch", "delta": 10, "duration": 16, "easing": "ease_out_expo"},
        {"type": "shake", "strength": 0.3, "duration": 30},
        {"type": "vignette", "strength": 0.6, "duration": 0}
      ]},
      {"tick": 0, "every": 2, "actions": [
        {"type": "particles", "particle": "minecraft:end_rod", "count": 12, "area": "center", "spread": 4.0, "speed": 0.12}
      ]},
      {"tick": 6, "actions": [
        {"type": "impact_frame", "texture": "frame_01", "duration": 2},
        {"type": "flash", "color": "#FFFFFF", "duration": 1, "fade": 2},
        {"type": "sound", "id": "skysdomains:domain.impact_frame", "volume": 1.0, "pitch": 1.0, "at": "player"}
      ]},
      {"tick": 14, "actions": [
        {"type": "impact_frame", "texture": "frame_02", "duration": 2},
        {"type": "flash", "color": "#FFFFFF", "duration": 1, "fade": 2},
        {"type": "sound", "id": "skysdomains:domain.impact_frame", "volume": 1.0, "pitch": 0.9, "at": "player"}
      ]},
      {"tick": 22, "actions": [
        {"type": "impact_frame", "texture": "frame_03", "duration": 2},
        {"type": "flash", "color": "#FFFFFF", "duration": 1, "fade": 2},
        {"type": "invert", "duration": 2},
        {"type": "sound", "id": "skysdomains:domain.impact_frame", "volume": 1.0, "pitch": 0.8, "at": "player"}
      ]}
    ],
    "expand": [
      {"tick": 0, "actions": [
        {"type": "sphere_scale", "from": 0.05, "to": 1.0, "duration": 20, "easing": "ease_out_expo"},
        {"type": "fog", "color": "#02020C", "density": 0.9},
        {"type": "sky", "id": "space"},
        {"type": "shake", "strength": 0.6, "duration": 12},
        {"type": "sound", "id": "skysdomains:structural_collapse.impact", "volume": 1.4, "pitch": 0.6, "at": "center"}
      ]},
      {"tick": 0, "every": 1, "actions": [
        {"type": "particles", "particle": "minecraft:end_rod", "count": 25, "area": "shell", "speed": 0.3}
      ]}
